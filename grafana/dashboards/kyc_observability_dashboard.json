{
  "title": "KYC Behavioral Observability - Full Stack Monitoring",
  "uid": "kyc-observability-main",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Consumer Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "up{job=\"kyc-consumer\"}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Events Processed (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "kyc_events_processed_total", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 3,
      "title": "Anomalies Flagged (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "kyc_anomalies_flagged_total", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "orange", "value": null }] } } }
    },
    {
      "id": 4,
      "title": "Anomaly Rate (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "100 * kyc_anomalies_flagged_total / kyc_events_processed_total", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 15 }] }
        }
      }
    },
    {
      "id": 5,
      "title": "Processing Errors (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "kyc_processing_errors_total", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 6,
      "title": "Inference Latency Percentiles (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(kyc_inference_latency_ms_bucket) by (le))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(kyc_inference_latency_ms_bucket) by (le))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(kyc_inference_latency_ms_bucket) by (le))", "legendFormat": "P99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "title": "Events Processed Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "kyc_events_processed_total", "legendFormat": "Events Processed", "refId": "A" },
        { "expr": "kyc_anomalies_flagged_total", "legendFormat": "Anomalies Flagged", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "title": "Feature & Model Output Drift (PSI)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "kyc_feature_psi", "legendFormat": "{{feature}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 0.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Feature Store Operations Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(kyc_feature_store_write_latency_ms_bucket) by (le))", "legendFormat": "Feature Store Write P95", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(kyc_api_inference_latency_ms_bucket) by (le))", "legendFormat": "FastAPI Scoring P95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 10,
      "title": "Node / Container CPU & Memory Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "kyc-prometheus" },
      "targets": [
        { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "Node CPU Usage (%)", "refId": "A" },
        { "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "Node Memory Usage (%)", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    }
  ]
}
