# ==============================================================================
# Dockerfile.jenkins -- Custom Jenkins Master Image with Python & ML Stack
# KYC Behavioral Observability Framework
# Student: Pranali Pandharinath Supekar (2024DA04387) | M.Tech DSE, BITS Pilani
# ==============================================================================

FROM jenkins/jenkins:lts-jdk17

USER root

# Install Python 3, pip, venv, build tools, postgres client headers, and docker CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3 \
    build-essential \
    libpq-dev \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Pre-create virtual environment and install project dependencies
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r /tmp/requirements.txt \
    && ln -sf /opt/venv/bin/* /usr/local/bin/ \
    && echo "/opt/venv/lib/python3.13/site-packages" > /usr/local/lib/python3.13/dist-packages/venv.pth

ENV PATH="/opt/venv/bin:${PATH}"

USER root
